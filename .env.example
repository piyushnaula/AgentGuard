APP_NAME=AgentGuard
APP_ENV=development
DATABASE_URL=sqlite:///./data/agentguard.db
POLICY_FILE=config/policies.yaml
LOG_LEVEL=INFO

# LLM Configuration (LangGraph Explanation Node)
# Default is Groq using langchain-groq
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Alternative: OpenAI or OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
